# mount point	fstype		device					device2

/bootloader 	vfat  		/dev/block/nanda 	flags=display="Bootloader";backup=1
/env      		emmc    	/dev/block/nandb 	flags=display="U-Boot env";backup=1
/boot			emmc		/dev/block/nandc 	flags=backup=1
/system			ext4		/dev/block/nandd 	flags=backup=1;formattable
/misc			emmc		/dev/block/nande 	flags=display="Misc"
/recovery		emmc		/dev/block/nandf 	flags=backup=1
/cache 			ext4		/dev/block/nandg 	flags=backup=1;wipeingui;wipeduringfactoryreset;formattable
/databk			ext4		/dev/block/nandh 	flags=backup=1;formattable
/data			ext4		/dev/block/nandi 	flags=backup=1;wipeingui;wipeduringfactoryreset;formattable
/external_sd	vfat		/dev/block/mmcblk0p1	/dev/block/mmcblk0 flags=storage;removable;fsflags=utf8
/usb-otg auto	/dev/block/sda1		/dev/block/sda flags=display="USB-OTG";storage;removable;fsflags=utf8
